{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "python.terminal.activateEnvironment": true
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Streamlit: app.py (หน้าเว็บ)",
                "type": "debugpy",
                "request": "launch",
                "module": "streamlit",
                "args": [
                    "run",
                    "${workspaceFolder}/src/app.py"
                ],
                "cwd": "${workspaceFolder}",
                "justMyCode": true,
                "env": {
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            {
                "name": "CVRP benchmark ทุกไฟล์ใน data (Terminal)",
                "type": "debugpy",
                "request": "launch",
                "program": "${workspaceFolder}/src/CVRP.py",
                "cwd": "${workspaceFolder}",
                "console": "integratedTerminal",
                "justMyCode": true,
                "env": {
                    "PYTHONIOENCODING": "utf-8"
                }
            }
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Setup environment (.venv)",
                "type": "shell",
                "windows": {
                    "command": "${workspaceFolder}\\setup_env.bat"
                },
                "osx": {
                    "command": "bash -c 'python3 -m venv .venv && .venv/bin/pip install -r requirements.txt'"
                },
                "linux": {
                    "command": "bash -c 'python3 -m venv .venv && .venv/bin/pip install -r requirements.txt'"
                },
                "options": {
                    "cwd": "${workspaceFolder}"
                },
                "problemMatcher": []
            }
        ]
    }
}
